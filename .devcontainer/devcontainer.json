// Development container for this repository: the image it defines, built here.
//
// Every other repository will name the published image, once the templates
// point at it. This one builds its own Dockerfile instead, so a change to the
// toolchain is worked on inside the machine it makes before anything
// publishes it, and adds Docker, so `make test` can build the image and check
// it from in here.
{
  "name": "Environment",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },

  // The user to work as, which the image's own label names too. Building
  // the image here, the dev container tools take their settings from the
  // Dockerfile's base, not from that label, and replace it with one of
  // their own when they add the feature below, so without this it is root.
  "remoteUser": "vscode",

  // Docker's engine, CLI and buildx come from Microsoft's signed moby
  // packages. The feature's own downloads of the newest buildx and of
  // Compose are switched off: neither is checked against a pin, and
  // `make test` needs neither.
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {
      "installDockerBuildx": false,
      "dockerDashComposeVersion": "none"
    }
  },

  "customizations": {
    "vscode": {
      // The template's essentials, and the image's own languages: its
      // checks are Python and its scripts are shell.
      "extensions": [
        "editorconfig.editorconfig",
        "eamodio.gitlens",
        "yzhang.markdown-all-in-one",
        "davidanson.vscode-markdownlint",
        "tamasfe.even-better-toml",
        "ms-python.python",
        "charliermarsh.ruff",
        "timonwong.shellcheck"
      ]

      // No "settings" block here on purpose. VS Code reads
      // .vscode/settings.json inside the container like anywhere else, so a
      // copy here would be a second source of truth.
    }
  },

  // What the template's container does when it is created: the scripts'
  // requirements, the git hooks in .github/scripts/hooks, and the commit
  // message template. The image already holds gitleaks, which the
  // pre-commit hook scans with.
  "postCreateCommand": "python3 -m pip install --user --require-hashes --only-binary=:all: --requirement .github/scripts/requirements.txt && git config core.hooksPath .github/scripts/hooks && git config commit.template .github/commit-template.txt"
}
